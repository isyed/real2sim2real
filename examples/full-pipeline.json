{
  "schema": "real2sim2real.pipeline/1",
  "input": "../data/input.mp4",
  "input_kind": "video",
  "output": "../runs/full-pipeline",
  "stages": [
    "reconstruction",
    "reconstruction-repair",
    "retargeting",
    "controller-actor-training"
  ],
  "modules": {
    "reconstruction": {
      "execution": {
        "python": "../.venv-reconstruction/bin/python",
        "timeout_seconds": 7200,
        "thermal": {
          "pause_c": 82,
          "resume_c": 74,
          "stop_c": 83
        }
      },
      "prompts": "prompts.json",
      "weights": "../model-store/reconstruction",
      "sam2_weights": "../model-store/sam2",
      "sam3d_weights": "../model-store/sam3d",
      "sequence_id": "my-sequence"
    },
    "reconstruction-repair": {
      "execution": {
        "python": "../.venv-repair/bin/python",
        "timeout_seconds": 1800,
        "cpu_only": true
      },
      "metric_evidence": "../data/metric-evidence.npz",
      "floor_roi_source": "Replace with reviewed floor ROI provenance",
      "repair": {
        "human_repair": false
      }
    },
    "retargeting": {
      "execution": {
        "python": "../.venv-retarget/bin/python",
        "timeout_seconds": 3600,
        "cpu_only": true
      },
      "assets": "../robot-assets",
      "mhr_model": "../model-store/reconstruction/sam3d_body/checkpoints/sam-3d-body-dinov3/assets/mhr_model.pt",
      "robot_config_root": "../modules/retargeting/src/real2sim2real/retargeting/configs",
      "robot": "g1",
      "human_to_robot_scale": 1.0,
      "contact_threshold_m": 0.02
    },
    "controller-actor-training": {
      "execution": {
        "python": "../.venv-training/bin/python",
        "timeout_seconds": 10800,
        "thermal": {
          "pause_c": 82,
          "resume_c": 74,
          "stop_c": 83
        }
      },
      "assets": "../robot-assets",
      "environment_steps": 10000000,
      "checkpoint_every": 5000000,
      "worlds": 256,
      "experiment": "g1_bounded_flash_sac",
      "overrides": []
    }
  }
}
